#!/usr/bin/env python3
import json
import os
import sys
import time
from datetime import datetime
from pathlib import Path


def main() -> int:
    try:
        count = int(sys.argv[1]) if len(sys.argv) > 1 else 5
    except ValueError:
        print("Usage: ox-agent-log [count]", file=sys.stderr)
        return 64

    if count < 1:
        print("Count must be at least 1", file=sys.stderr)
        return 64

    state_base = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
    log_root = state_base / "ox-alpha-workers"
    runs_root = log_root / "runs"
    run_dirs = sorted((path for path in runs_root.glob("*") if path.is_dir()), reverse=True)[:count]

    print(f"Ox Alpha logs: {log_root}")
    quota_path = log_root / "quota.json"
    try:
        quota = json.loads(quota_path.read_text(encoding="utf-8"))
        blocked_until = float(quota.get("blocked_until_epoch", 0))
        if blocked_until > time.time():
            deadline = datetime.fromtimestamp(blocked_until).astimezone().isoformat(timespec="seconds")
            remaining = int(blocked_until - time.time() + 0.999)
            print(f"Quota cooldown: active until {deadline} ({remaining}s remaining)")
    except (OSError, ValueError, TypeError, json.JSONDecodeError):
        pass

    if not run_dirs:
        print("No logged invocations yet.")
        return 0

    print("started_at            think  status           exit  sec   lines  project  run_id")
    for run_dir in run_dirs:
        meta_path = run_dir / "meta.json"
        try:
            meta = json.loads(meta_path.read_text(encoding="utf-8"))
            status = meta.get("status")
            if not status:
                exit_status = meta["exit_status"]
                try:
                    output = Path(meta["output_file"]).read_text(encoding="utf-8", errors="replace")
                except (OSError, KeyError):
                    output = ""
                if "free-models-per-day" in output:
                    status = "quota_exhausted"
                elif exit_status == 0:
                    status = "completed"
                elif exit_status in (130, 143):
                    status = "interrupted"
                else:
                    status = "failed"
            print(
                f"{meta['started_at']:<21} "
                f"{meta.get('thinking_level', '-'):<5}  "
                f"{status:<15}  "
                f"{meta['exit_status']:>4}  "
                f"{meta['duration_seconds']:>3}  "
                f"{meta['output_lines']:>6}  "
                f"{meta['cwd']}  "
                f"{meta['run_id']}"
            )
        except FileNotFoundError:
            output_path = run_dir / "output.log"
            try:
                lines = output_path.read_bytes().count(b"\n")
            except OSError:
                lines = 0
            started = run_dir.name[:15]
            print(f"{started:<21} {'-':<5}  {'incomplete':<15}  {'-':>4}  {'-':>3}  {lines:>6}  -  {run_dir.name}")
        except (OSError, KeyError, json.JSONDecodeError) as error:
            print(f"{run_dir.name}: unreadable metadata ({error})")

    print("New run directories contain request.txt, output.log, meta.json, Git snapshots, and process-specific omp logs.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
